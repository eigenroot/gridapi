# Example only. Copy to /opt/grid/.env on the Droplet and chmod 600.
# Values in this file are not production credentials.
GRID_API_IMAGE=ghcr.io/eigenroot/gridapi:replace-commit-sha
API_DOMAIN=grid-api.eigenroot.com
ACME_EMAIL=you@example.com

# Use Neon Connect -> .NET/Npgsql. This API expects the semicolon format,
# not a postgresql:// URL. Use a direct hostname for startup migrations.
ConnectionStrings__Grid=Host=replace-neon-host;Port=5432;Database=neondb;Username=neondb_owner;Password=replace-password;SSL Mode=VerifyFull;Maximum Pool Size=20;Timeout=30

# Generate each of these independently using: openssl rand -base64 32
# Keep them unchanged between releases and store a recovery copy securely.
Jwt__SigningKey=
Otp__Pepper=
Payouts__EncryptionKey=

# First deployment, single API instance: apply existing EF migrations at startup.
# After the first successful start, set false and recreate the API container.
# For later schema changes, back up the database and explicitly enable again.
Database__MigrateOnStartup=true

Sms__Provider=Arkesel
Sms__SenderId=GRID
Sms__Arkesel__ApiKey=
Sms__Arkesel__Sandbox=false
