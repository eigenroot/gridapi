  "Jwt": {
    "Issuer": "grid-api",
    "Audience": "grid-apps",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 60
  },
  "Sms": {
    "Provider": "Log",
    "FallbackProvider": null,
    "SenderId": "GRID",
    "Arkesel": {
      "ApiKey": "",
      "BaseUrl": "https://sms.arkesel.com",
      "Sandbox": false
    },
    "Hubtel": {
      "ClientId": "",
      "ClientSecret": "",
      "BaseUrl": "https://sms.hubtel.com"
    }
  },
  "Kyc": {
    "Provider": "None",
    "RunWorker": true,
    "PollIntervalSeconds": 15,
    "BatchSize": 20,
